 // This is used to ensure we only kill Simulator processes and not host OS processes
 let simulatorPathSearchKey = "simruntime/Contents/Resources/RuntimeRoot"
 
+// Stock posters and widgets saturated the screenshot runner (load >500),
+// starving even localhost API requests. Match observed OS bundles, not all
+// extensions: WebKit and ArchiveBox's own widgets must keep running.
+func isSimulatorBackgroundExtension(_ path: String) -> Bool {
+    guard let root = path.range(of: simulatorPathSearchKey + "/") else { return false }
+    let parts = path[root.upperBound...].split(separator: "/")
+    guard parts.count >= 3, parts[0] == "System" || parts[0] == "Applications" else { return false }
+    let bundle = parts[parts.count - 2]
+    return [
+        "MercuryPosterExtension.appex", "PridePosterExtension.appex",
+        "Unity2025Poster.appex", "WeatherPoster.appex", "RhizomePoster.appex",
+        "ScreenTimeWidgetExtension.appex", "CalendarWidgetExtension.appex",
+        "GeneralMapsWidget.appex", "NewsTag.appex", "NewsTodayIntents.appex",
+        "HealthMentalHealthWidgetExtension.appex", "SleepWidgetExtension.appex",
+        "HealthMedicationsWidgetExtension.appex", "HealthCycleTrackingWidgetExtension.appex",
+        "SafariWidgetExtension.appex", "FitnessWidget.appex", "AdaptiveMusicWidget.appex",
+        "PassbookWidgetsExtension-iPhone.appex", "PassbookLockedWidgetsExtension.appex",
+    ].contains(bundle)
+}
+
 // How long to sleep between checks
 let sleepDelay: UInt32 = 5
 
