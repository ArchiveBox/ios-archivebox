 // This is used to ensure we only kill Simulator processes and not host OS processes
 let simulatorPathSearchKey = "simruntime/Contents/Resources/RuntimeRoot"
 
+// Only simulator OS wallpaper extensions, never host or installed app processes.
+func isSimulatorPosterExtension(_ path: String) -> Bool {
+    guard let root = path.range(of: simulatorPathSearchKey + "/") else { return false }
+    let parts = path[root.upperBound...].split(separator: "/")
+    let systemExtension = parts.count == 6 && parts[0] == "System" && parts[1] == "Library"
+        && parts[2] == "ExtensionKit" && parts[3] == "Extensions"
+    let bundledExtension = parts.count == 5 && parts[0] == "Applications"
+        && parts[1].hasSuffix(".app") && (parts[2] == "Extensions" || parts[2] == "PlugIns")
+    guard systemExtension || bundledExtension else { return false }
+    let bundle = parts[parts.count - 2]
+    let executable = parts[parts.count - 1]
+    guard bundle.hasSuffix(".appex") else { return false }
+    return bundle.dropLast(".appex".count) == executable
+        && (executable.contains("Poster") || executable == "SleepWidgetExtension")
+}
+
 // How long to sleep between checks
