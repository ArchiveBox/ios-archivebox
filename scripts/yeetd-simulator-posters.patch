 // This is used to ensure we only kill Simulator processes and not host OS processes
 let simulatorPathSearchKey = "simruntime/Contents/Resources/RuntimeRoot"
 
+// Stop only bundled system extensions in a disposable Simulator runtime.
+// Installed ArchiveBox/Safari app extensions live in device data, outside this root.
+func isSimulatorSystemExtension(_ path: String) -> Bool {
+    guard let root = path.range(of: simulatorPathSearchKey + "/") else { return false }
+    let parts = path[root.upperBound...].split(separator: "/")
+    guard parts.count >= 3, parts[0] == "System" || parts[0] == "Applications" else { return false }
+    let bundle = parts[parts.count - 2]
+    return bundle.hasSuffix(".appex")
+}
